# Site URL (set to production domain for sitemap/metadata)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email
RESEND_API_KEY=
# Where contact-form enquiries are delivered
CONTACT_EMAIL=
# Verified sender, e.g. "Ilm Learning Center <no-reply@ilmlearningcenter.com>"
# Falls back to Resend's sandbox sender (dev only) when unset
CONTACT_FROM=
