# Absolute origin used for canonicals, hreflang, the sitemap and OG image URLs.
#
# Local dev: leave blank (falls back to http://localhost:3000).
# Vercel:    optional — deployments fall back to the project's own production
#            domain automatically, so previews and the .vercel.app URL are
#            already correct. Set this explicitly once the real custom domain
#            is live. No trailing slash.
#
# Example: NEXT_PUBLIC_SITE_URL=https://ilmlearningcenter.com
NEXT_PUBLIC_SITE_URL=
